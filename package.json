{
  "name": "folego-do-mes",
  "private": true,
  "version": "1.0.0",
  "description": "Fôlego do Mês — Plataforma preditiva de liquidez e gestão de compromissos financeiros",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.quality.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "test:e2e": "playwright test --grep-invert visual:",
    "test:a11y": "playwright test a11y.spec.ts",
    "test:visual": "playwright test visual.spec.ts",
    "test:visual:update": "playwright test visual.spec.ts --update-snapshots",
    "audit:ui": "node scripts/ui-audit.mjs",
    "audit:performance": "node scripts/ui-performance.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.17",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4.0.17",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.2.3",
    "vitest": "^5.0.5"
  }
}
